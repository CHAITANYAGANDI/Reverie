# Copy to .env.local. Defaults let the frontend run in dev auth mode with NO Clerk key.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws
# dev  = send X-Dev-User header (no Clerk account needed)
# clerk = use Clerk session JWT as Authorization: Bearer
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Where Reverie's own sign-in and sign-up screens live.
#
# Clerk is told this three ways -- these variables, the provider props in
# lib/clerk-auth.tsx, and the OAuth callback in app/sso-callback -- because
# where any one of them is missing Clerk does not fail. It falls back to its
# hosted Account Portal on <slug>.accounts.dev, which is a different domain
# wearing a different brand, and pressing Cancel on a Google sign-in lands
# somebody there instead of back on Reverie's form.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

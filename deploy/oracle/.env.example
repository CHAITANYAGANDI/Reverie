# Reverie on Oracle — environment template.
#
#   cp .env.example .env
#   chmod 600 .env
#   # then fill it in on the VM, never in Git
#
# .env is gitignored at every depth (.gitignore line 14). This file is the only
# one of the pair that is tracked, and it must never contain a real value.
#
# Every name here is taken from render.yaml, application.yml or ai-service's
# config.py. Nothing is invented: if a name looks odd -- SPRING_KAFKA_* on one
# service and KAFKA_* on the other -- that is what the code reads.
#
# Values marked SAME AS RENDER can be copied out of the Render dashboard during
# migration. Render stays live as the rollback, so copy rather than move.

# =============================================================================
# Deployment identity
# =============================================================================

# The public hostname for the backend. Caddy obtains a certificate for exactly
# this name, so it must already resolve to this VM's public IP.
BACKEND_HOSTNAME=api.example.com

# Where Let's Encrypt sends certificate-expiry warnings.
ACME_EMAIL=ops@example.com


# =============================================================================
# Spring — profile and identity
# =============================================================================

# Switches on DeploymentCheck, disables the API browser and the metrics
# endpoint, and trusts the proxy's forwarded headers. Do not change it.
SPRING_PROFILES_ACTIVE=production

# Vercel's origin. This is the ONLY allowed CORS origin and the only allowed
# STOMP origin (SecurityConfig, WebSocketConfig). It does not change in this
# migration -- the frontend stays on Vercel.
APP_FRONTEND_URL=https://reverie.example.com

# Where this API is reachable from the internet. THIS CHANGES FOR ORACLE: it
# was the Render URL and becomes https://$BACKEND_HOSTNAME. DeploymentCheck
# refuses to start if it is a localhost or docker-internal address.
APP_PUBLIC_URL=https://api.example.com


# =============================================================================
# PostgreSQL — three passwords, and nothing else
# =============================================================================
#
# The database is local now: PostgreSQL 16 with pgvector, in this stack, on the
# private bridge. Neon is gone.
#
# Only the passwords live here. Host, port, database name and the three role
# names are set in docker-compose.yml, because they are facts about that file
# -- `postgres` is a service name in it -- and a hostname in .env is how a
# stale one survives a migration and points production at a database nobody is
# writing to any more.
#
# GENERATE THESE. Three distinct values, never reused from anywhere:
#   openssl rand -base64 24
#
# They are consumed twice each and must not drift: postgres-init/01-roles.sh
# creates the roles with them on first boot, and the applications log in with
# them afterwards. Changing one here later does NOT change the database -- the
# init script runs once. See README "Rotating a database password".

# reverie_app. Unprivileged, NOBYPASSRLS, so the V9 policies actually bind.
# Spring's tenant traffic and the worker's RAG traffic both use it.
SPRING_DATASOURCE_PASSWORD=

# reverie_sys. BYPASSRLS, for the paths with no user behind them: worker
# callbacks, the outbox relay, provisioning.
REVERIE_DATASOURCE_SYSTEM_PASSWORD=

# reverie. The schema owner and superuser -- Flyway's login, and also the
# postgres container's POSTGRES_PASSWORD, because they are the same account.
# The only one that can alter the schema or drop a policy.
FLYWAY_PASSWORD=


# =============================================================================
# Confluent Cloud  —  SAME AS RENDER, unchanged by this migration
# =============================================================================

# Note the SPRING_ prefix: this one is read by Spring Boot's Kafka binding.
SPRING_KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.eu-central-1.aws.confluent.cloud:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
# Spring wants the whole JAAS line. The API key is the username and the API
# secret is the password.
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username='API_KEY' password='API_SECRET';

# The ai-service reads the same broker through different names.
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.eu-central-1.aws.confluent.cloud:9092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=


# =============================================================================
# Cloudflare R2  —  SAME AS RENDER, unchanged by this migration
# =============================================================================
#
# Recordings stay in R2. Nothing user-generated is written to the VM's disk.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# The same host: R2's endpoint is reachable from the internet, so a browser can
# follow a presigned URL straight to it.
S3_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=reverie
# R2 signs with this and wants `auto`.
S3_REGION=auto


# =============================================================================
# Clerk  —  SAME AS RENDER
# =============================================================================
#
# NOTE: production currently runs against a Clerk DEVELOPMENT instance. That is
# a real launch-hardening item and is tracked separately -- it is not part of
# this migration and no value here changes because of Oracle.
REVERIE_AUTH_MODE=clerk
CLERK_ISSUER=https://xxxx.clerk.accounts.dev
CLERK_JWKS_URL=https://xxxx.clerk.accounts.dev/.well-known/jwks.json
# Backend API credential, used for exactly one thing: resolving a verified
# primary email so the lifetime free allowance has a durable identity.
CLERK_SECRET_KEY=


# =============================================================================
# Shared secrets
# =============================================================================

# The shared secret on /internal/**. BOTH services read this name and the
# values MUST match, or every worker callback returns 401. Generate once:
#   openssl rand -hex 32
REVERIE_INTERNAL_TOKEN=

# Turns a verified email into the durable identity of one lifetime free
# allowance. MUST be the value already in production: change it and every
# returning user looks new and is handed another allowance, silently.
# Back this up together with the database.
FREE_TIER_IDENTITY_HMAC_SECRET=


# =============================================================================
# Sentry — three projects, and two of them are here
# =============================================================================
#
# Both services read a variable literally called SENTRY_DSN, and they are
# different projects. One file cannot hold two values under one name, so they
# are named apart here and docker-compose.yml maps each back to SENTRY_DSN for
# the right container. Leave either blank to run with monitoring off.
SENTRY_DSN_BACKEND=
SENTRY_DSN_AI=
# Backend only.
SENTRY_ENVIRONMENT=production
# ai-service only. Its own name for the same idea.
REVERIE_ENV=production


# =============================================================================
# Resend — email  —  SAME AS RENDER
# =============================================================================
RESEND_API_KEY=
# Must be a verified domain. DeploymentCheck rejects resend.dev and other
# development sender domains in production.
REVERIE_MAIL_FROM=Reverie <notes@example.com>
# "This deployment has no users other than me." Enforced, not trusted: with it
# on, SelfOnlyAccess refuses provisioning for every other Clerk subject.
REVERIE_MAIL_SELF_ONLY=false
# Required when SELF_ONLY is true. The Clerk user id (starts with `user_`),
# not an email address.
REVERIE_MAIL_SELF_USER_ID=


# =============================================================================
# ai-service — providers
# =============================================================================
#
# `mock` is the deterministic offline provider and costs nothing. Set to the
# real provider only when this host is meant to be doing production work.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small

# Speech-to-text is chosen separately from the LLM: AssemblyAI diarizes.
TRANSCRIPTION_PROVIDER=auto
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-3-5-pro
ASSEMBLYAI_FALLBACK_MODEL=universal-2


# =============================================================================
# ai-service — the database, for RAG
# =============================================================================
#
# Nothing to set. The worker connects to the same PostgreSQL for transcript
# chunk storage and retrieval, as the same unprivileged role Spring uses, and
# every PG_* value is set in docker-compose.yml -- including the password,
# which is interpolated from SPRING_DATASOURCE_PASSWORD above rather than kept
# here a second time under a second name to drift out of step.


# =============================================================================
# JVM — Oracle sizing
# =============================================================================
#
# Optional override. The default lives in docker-compose.yml and is explained
# in README "JVM sizing". Do NOT copy Render's MaxRAMPercentage values here:
# they were chosen for a 512 MB box and mean something entirely different
# against a 2 GB container limit.
# BACKEND_JAVA_OPTS=-Xms512m -Xmx1024m
